PORT=5000
MONGODB_URI=
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
AI_API_KEY=
AI_MODEL=
# Long-document AI processing defaults: 5 chunks, 6,000 chars/chunk, 45 seconds total.
# AI_MAX_CHUNKS=5
# AI_CHUNK_CHARS=6000
# AI_TOTAL_TIMEOUT_MS=45000
# Optional brand guideline ingestion limits; defaults: 8 chunks, 40 items, 60 seconds overall.
# AI_INGEST_MAX_CHUNKS=8
# AI_INGEST_MAX_ITEMS=40
# AI_INGEST_TOTAL_TIMEOUT_MS=60000
JWT_SECRET=
JWT_EXPIRES_IN=7d
SEED_DEMO_PASSWORD=
ALLOW_SELF_APPROVAL=true
# Optional document extraction limits.
# MAX_UPLOAD_MB=5
# MAX_DOC_CHARS=60000
# MAX_PDF_PAGES=100
# Optional quality-check threshold overrides; defaults are documented in README.md.
# QUALITY_LONG_SENTENCE_MEDIUM_WORDS=30
# QUALITY_LONG_SENTENCE_HIGH_WORDS=45
# QUALITY_HARD_TO_READ_GRADE=16
# QUALITY_HARD_TO_READ_MIN_WORDS=12
# QUALITY_PASSIVE_MIN_OCCURRENCES=2
# QUALITY_RAW_URL_LINK_TEXT_CHARS=60
# QUALITY_ALL_CAPS_MIN_WORDS=3
# QUALITY_JARGON_TERMS=synergy,leverage,utilize
# QUALITY_ACRONYMS=API,CEO,HTML,URL
